# Copy this file to .env and fill in your key. Never commit .env.
# Any OpenAI-compatible API works; these values use Google's free Gemini API (https://aistudio.google.com/apikey).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-key-here
LLM_MODEL=gemini-3.5-flash-lite
LLM_SLEEP_SECONDS=5

# Optional: judge models used by src/rank.py (defaults shown)
# JUDGE_HEAT_MODEL=gemma-4-31b-it
# JUDGE_FINAL_MODEL=gemini-3.8-flash
